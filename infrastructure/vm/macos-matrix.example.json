{
  "metadata": {
    "schema_version": "1",
    "description": "Local macOS VM matrix for dotfiles end-to-end validation",
    "default_backend": "tart",
    "notes": "Copy this file to macos-matrix.local.json and replace beta IPSW path with a valid Apple seed IPSW file."
  },
  "profiles": [
    {
      "name": "current",
      "enabled": true,
      "backend": "tart",
      "track": "stable",
      "vm_name": "dotfiles-macos-current",
      "ipsw": "latest",
      "ssh_host_strategy": "tart-ip",
      "ssh_port": 22,
      "ssh_user": "admin"
    },
    {
      "name": "beta",
      "enabled": true,
      "backend": "tart",
      "track": "developer-seed",
      "vm_name": "dotfiles-macos-beta",
      "ipsw": "REPLACE_WITH_LOCAL_BETA_IPSW_PATH",
      "ssh_host_strategy": "tart-ip",
      "ssh_port": 22,
      "ssh_user": "admin"
    }
  ]
}
