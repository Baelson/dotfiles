# BATS Configuration for macOS Dotfiles Testing
#
# This configuration file defines global settings for BATS test execution
# across all test suites in the dotfiles project.

# Test discovery and execution
filter_tags=""
filter_status=""

# Output formatting
formatter="tap"
show_output_of_passing_tests=false

# Timing and performance
print_output_on_failure=true
timing=false

# Test environment
setup_suite_file=""
setup_file=""
teardown_suite_file=""
teardown_file=""

# Parallel execution (disabled for macOS system-level tests to avoid conflicts)
jobs=1

# TAP output configuration (for GitHub Actions integration)
tap=false