[user]
	email = Baelson@users.noreply.github.com
	name = Baelson
[diff]
	tool = bc
[difftool "bc"]
	cmd = /Applications/Beyond\\ Compare.app/Contents/MacOS/bcomp \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = bc
[mergetool "bc"]
	cmd = /Applications/Beyond\\ Compare.app/Contents/MacOS/bcomp \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
[difftool]
	prompt = false
[pager]
	log = false
[alias]
	logpretty = log --pretty=format:'%C(yellow)%h%C(reset) %C(cyan)%cr%C(reset) (%C(cyan)%cd%C(reset)) %<(60,trunc)%s %C(auto)%d%C(reset)' --abbrev-commit --decorate=short --date=format:'%Y-%m-%d @ %H:%m' -n 5
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[push]
	# Auto-track upstream on first push of a new branch (treats `git push` on
	# an untracked branch as `git push --set-upstream origin <branch>`).
	# Without this, new branches we create for private-repo work don't get
	# upstream tracking, which then breaks `git pull` / `chezmoi update` /
	# any "current branch against its upstream" operation until someone
	# remembers to set the upstream manually. Global policy; see
	# ~/.claude/rules/git-workflow.md "Branch upstream tracking".
	autoSetupRemote = true
	# Push the current branch to origin/<same-name>. Makes the upstream
	# inferred by autoSetupRemote land where we expect it.
	default = current
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
