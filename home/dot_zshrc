############################################
###             Personal Aliases         ###
############################################
# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# Pretty-print of some PATH variables:
alias path="echo -e '${PATH//:/\\n}'" # Note ${...} wrapped with single quotes; suppress expansion as alias
alias libpath="echo -e ${LD_LIBRARY_PATH//:/\\n}"
alias reload="source ~/.zshenv; source ~/.zshrc; source ~/.zprofile"

alias ls="gls -FHhv --group-directories-first --color=always"
alias lsa="gls -FHhav --group-directories-first --color=always"
alias l="gls -FHhlGvo --group-directories-first --color=always --time-style=long-iso"
alias ll="gls -FHhGvoa --group-directories-first --color=always --time-style=long-iso"

alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"
alias mkdir="mkdir -p"
alias dirs="dirs -v"
alias h="history"
alias j="jobs -l"
alias which="type -a"
alias -- -="cd -"
alias grep="grep --color=auto"
alias -g sendclip="| pbcopy"
alias -g getclip="pbpaste |"
alias du="du -kh"    # Makes a more readable output.
alias df="df -kTh"
alias tree="tree -Csuh"    #  Nice alternative to "recursive ls" ...

# pushd shortcuts
alias icloud="pushd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"   # pushd to iCloud Drive
alias box="pushd ~/Library/CloudStorage/Box-Box/"                       # pushd to Box Drive
alias onedrive="pushd ~/Library/CloudStorage/OneDrive-Personal/"        # pushd to OneDrive
alias dcconfigs="pushd ~/Git/DuqueClan-Configs"                         # pushd to DuqueClan Configs Repo

# git alias'
alias gdd="git difftool --dir-diff --no-symlinks"
alias grsa="git restore --staged ."


############################################
###             key bindings             ###
############################################
bindkey "^[b" backward-word
bindkey "^[f" forward-word
bindkey "^[a" beginning-of-line
bindkey "^[e" end-of-line


