# Brewfile Template - macOS Development Environment
# =================================================
#
# This template dynamically generates package lists based on your environment configuration.
# It uses chezmoi's templating system to install different packages for different machine types.
#
# References:
# - Homebrew Bundle: https://github.com/Homebrew/homebrew-bundle
# - chezmoi templating: https://www.chezmoi.io/user-guide/templating/
# - Package management patterns: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/

{{- /* Default mas to false if not provided (backwards-compatible with tests) */ -}}
{{- $mas := false -}}
{{- if hasKey . "mas" -}}{{- $mas = .mas -}}{{- end -}}
{{- /* is_primary gates apps/extensions that should only land on the primary Mac */ -}}
{{- $is_primary := false -}}
{{- if hasKey . "is_primary" -}}{{- $is_primary = .is_primary -}}{{- end -}}
{{- /* skip_flaky_casks omits casks with unreliable downloads/installers in --no-graphics VMs: zoom PKG hangs; orbstack CDN times out */ -}}
{{- $skip_flaky_casks := false -}}
{{- if hasKey . "skip_flaky_casks" -}}{{- $skip_flaky_casks = .skip_flaky_casks -}}{{- end -}}


# Generated Configuration:
# Environment: {{ if .work }}work{{ else if .personal }}personal{{ else }}unknown{{ end }}
# Hostname: {{ .hostname }}
# Ephemeral: {{ .ephemeral }} ({{ if .ephemeral }}minimal packages, no GUI apps{{ else }}full installation{{ end }})
# Headless: {{ .headless }} ({{ if .headless }}CLI tools only{{ else }}includes GUI applications{{ end }})
# MAS: {{ $mas }} ({{ if $mas }}Mac App Store apps included{{ else }}MAS apps skipped — defaults true on your-primary-host; set CHEZMOI_MAS=true elsewhere{{ end }})


# Package Categories:
# - Core development tools (all environments)
# - Shell and terminal enhancements
# - Programming languages and tools
# - GUI Applications (non-headless only)
# - Environment-specific packages (personal/work)
# - Mac App Store applications (persistent, personal environments only)

# Tap repositories
tap 'cirruslabs/cli', trusted: true
tap 'steipete/tap', trusted: true
tap 'getsentry/xcodebuildmcp', trusted: true
tap 'antoniorodr/memo', trusted: true
tap 'rcmdnk/file', trusted: true
tap 'xdevplatform/tap', trusted: true


# Core development tools (all environments)
brew 'chezmoi'          # Manage your dotfiles across multiple diverse machines, securely       -- https://github.com/twpayne/chezmoi
brew 'coreutils'        # GNU File, Shell, and Text utilities                                   -- https://git.savannah.gnu.org/git/coreutils
brew 'gh'               # GitHub command-line tool                                              -- https://github.com/cli/cli
brew 'git'              # Distributed revision control system                                   -- https://github.com/git/git
brew 'gzip'             # Popular GNU data compression programming                              -- https://www.gnu.org/software/gzip/
brew 'less'             # Pager program similar to more                                         -- https://github.com/gwsw/less
brew 'make'             # Utility for directing compilation                                     -- https://git.savannah.gnu.org/git/make
brew 'rsync'            # Utility that provides fast incremental file transfer                  -- https://rsync.samba.org/
brew 'age'              # Modern encryption — used by chezmoi for SSH key blobs                 -- https://github.com/FiloSottile/age
brew 'bats-core'        # Bash Automated Testing System — dotfiles test suite runner            -- https://github.com/bats-core/bats-core
brew 'git-filter-repo'  # Quickly rewrite git repository history                                -- https://github.com/newren/git-filter-repo
brew 'gitleaks'         # Secret/credential scanner — used in dotfiles scrub pipeline           -- https://github.com/gitleaks/gitleaks
brew 'pre-commit'       # Multi-language pre-commit hook framework                              -- https://pre-commit.com/
brew 'yq'               # Portable YAML/JSON/XML/TOML processor                                 -- https://github.com/mikefarah/yq

# Shell and terminal enhancements
brew 'antigen'          # Plugin manager for zsh, inspired by oh-my-zsh and vundle              -- https://github.com/zsh-users/antigen
brew 'direnv'           # Load/unload environment variables based on $PWD                       -- https://github.com/direnv/direnv
brew 'eza'              # Modern, maintained replacement for ls                                 -- https://github.com/eza-community/eza
brew 'fd'               # Simple, fast and user-friendly alternative to find                    -- https://github.com/sharkdp/fd
brew 'fzf'              # Command-line fuzzy finder written in Go                               -- https://github.com/junegunn/fzf
brew 'ripgrep'          # Search tool like grep and The Silver Searcher                         -- https://github.com/BurntSushi/ripgrep
brew 'tree'             # Display directories as trees (with optional color/HTML output)        -- http://mama.indstate.edu/users/ice/tree/
{{- if not .headless }}
brew 'tmux'             # Terminal multiplexer                                                  -- https://github.com/tmux/tmux
brew 'steipete/tap/tmuxwatch'  # Live tmux dashboard with Bubble Tea UI                         -- https://github.com/steipete/tmuxwatch
{{- end }}
brew 'zsh-completions'  # Additional completion definitions for zsh-users                       -- https://github.com/zsh-users/zsh-completions

# Programming languages and tools
brew 'node'             # Platform built on V8 to build network applications                    -- https://github.com/nodejs/node
brew 'pygments'         # Generic syntax highlighter                                            -- https://github.com/pygments/pygments
brew 'python3'          # Interpreted, interactive, object-oriented programming language        -- https://www.python.org/
brew 'ruby'             # Powerful, clean, object-oriented scripting language                   -- https://github.com/ruby/ruby
brew 'uv'               # Extremely fast Python package installer and resolver                  -- https://github.com/astral-sh/uv
brew 'xcodegen'         # Generate your Xcode project from a spec file                          -- https://github.com/yonaskolb/XcodeGen
brew 'getsentry/xcodebuildmcp/xcodebuildmcp'    # MCP and CLI providing iOS/macOS dev tools to AI agents -- https://github.com/getsentry/XcodeBuildMCP

# Text editors and utilities
brew 'gawk'             # GNU awk utility                                                       -- https://git.savannah.gnu.org/git/gawk
brew 'nano'             # Free (GNU) replacement for the Pico text editor                       -- https://www.nano-editor.org/
brew 'neovim'           # Ambitious Vim-fork focused on extensibility and agility               -- https://github.com/neovim/neovim
brew 'pandoc'           # Swiss-army knife of markup format conversion                          -- https://pandoc.org/
brew 'shellcheck'       # Shell script static analysis tool                                     -- https://github.com/koalaman/shellcheck

{{- if not .ephemeral }}
# Media, system, and virtualization tools (persistent environments only)
brew 'cirruslabs/cli/tart' # macOS and Linux VMs on Apple Silicon for CI and automation         -- https://tart.run/
brew 'ddrescue'            # GNU data recovery tool                                             -- https://www.gnu.org/software/ddrescue/ddrescue.html
brew 'ffmpeg'              # Play, record, convert, and stream audio and video                  -- https://github.com/FFmpeg/FFmpeg
brew 'mas'                 # Mac App Store command-line interface                               -- https://github.com/mas-cli/mas
{{- end }}

{{- if .personal }}
# Personal environment packages
# brew 'mackup'           # Keep your Mac's application settings in sync                        -- https://github.com/lra/mackup
{{- end }}


brew 'rcmdnk/file/brew-file'  # Brewfile manager for Homebrew                                   -- https://github.com/rcmdnk/homebrew-file

{{- if $is_primary }}
# your-primary-host-only development tools (primary Mac)
brew 'act'                  # Run your GitHub Actions locally                                       -- https://nektosact.com
brew 'antoniorodr/memo/memo'    # CLI app to manage your Apple Notes and Apple reminders            -- https://github.com/antoniorodr/memo
brew 'block-goose-cli'      # Open source, extensible AI agent that goes beyond code suggestions    -- https://goose-docs.ai/
brew 'claude-cmd'           # Claude Code Commands Manager                                          -- https://github.com/kiliczsh/claude-cmd
brew 'claude-hooks'         # Hook system for Claude Code                                           -- https://github.com/johnlindquist/claude-hooks
brew 'create-dmg'           # Shell script to build fancy DMGs                                      -- https://github.com/create-dmg/create-dmg
brew 'difftastic'           # Diff that understands syntax                                          -- https://difftastic.wilfred.me.uk/
brew 'go'                   # Open source programming language to build simple/reliable/efficient software  -- https://go.dev/
brew 'monolith'             # CLI tool for saving complete web pages as a single HTML file          -- https://github.com/Y2Z/monolith
brew 'opencode'             # AI coding agent, built for the terminal                               -- https://opencode.ai
brew 'pkgconf'              # Package compiler and linker metadata toolkit                          -- https://github.com/pkgconf/pkgconf
brew 'sevenzip'             # 7-Zip is a file archiver with a high compression ratio                -- https://7-zip.org
brew 'summarize'            # Multi-modal AI tool to extract and summarize content                  -- https://summarize.sh
{{- end }}

{{- if not .headless }}
# GUI Applications (non-headless environments)

# Fonts (required for p10k/tmux status line glyphs)
cask 'font-meslo-lg-nerd-font'  # Meslo Nerd Font — Powerline glyphs for p10k and tmux          -- https://github.com/ryanoasis/nerd-fonts

# Development tools (cross-machine)
cask 'beyond-compare'       # Compare files and folders                                         -- https://www.scootersoftware.com/
cask 'chatgpt'              # OpenAI's official ChatGPT desktop app                             -- https://chatgpt.com/
cask 'claude'               # Anthropic's official Claude AI desktop app                        -- https://claude.ai/download
cask 'iterm2'               # Terminal emulator as alternative to Apple's Terminal app          -- https://iterm2.com/
cask 'itermai'              # Enable generative AI features in iTerm2                           -- https://iterm2.com/ai-plugin.html
cask 'obsidian'             # Knowledge base in local folder of plain text Markdown files       -- https://obsidian.md/
cask 'postman'              # Collaboration platform for API development                        -- https://www.postman.com/
cask 'sublime-text'         # Text editor for code, markup and prose                            -- https://www.sublimetext.com/
cask 'visual-studio-code'   # Open-source code editor                                           -- https://code.visualstudio.com/
{{- if and .work $is_primary }}
cask 'webex-meetings'       # Video communication and virtual meeting platform (work, primary host) -- https://www.webex.com/
{{- end }}
{{- if not $skip_flaky_casks }}
cask 'orbstack'             # Fast, lightweight Docker & Linux on macOS (primary runtime)       -- https://orbstack.dev/
cask 'zoom'                 # Video communication and virtual meeting platform                  -- https://www.zoom.us/
{{- end }}
cask 'libreoffice'          # Free cross-platform office suite                                 -- https://www.libreoffice.org/
cask 'tailscale-app'        # Mesh VPN based on WireGuard                                      -- https://tailscale.com/

{{- if $is_primary }}
# your-primary-host-only development tools (primary Mac)
cask 'alfred'               # Application launcher and productivity software                    -- https://www.alfredapp.com/
cask 'codex'                # OpenAI's coding agent that runs in your terminal                  -- https://github.com/openai/codex
cask 'github'               # Desktop client for GitHub repositories                            -- https://desktop.github.com/
cask 'menuwhere'            # Access the menu from anywhere                                     -- https://manytricks.com/menuwhere/
cask 'sublime-merge'        # Git client                                                        -- https://www.sublimemerge.com/
cask 'openusage'            # AI usage tracker for Cursor, Claude Code, Codex, Copilot and more -- https://www.openusage.ai/
cask 'xdevplatform/tap/xurl' # Auth-enabled curl-like CLI for the X API                          -- https://github.com/xdevplatform/xurl
{{- end }}

{{- if .personal }}
# Personal applications
cask 'softraid'             # Powerful and intuitive software RAID utility                      -- https://www.softraid.com/
{{- if $is_primary }}
cask 'discord'              # Voice and text chat software                                      -- https://discord.com/
cask 'figma'                # Collaborative team software                                       -- https://www.figma.com/
{{- end }}
{{- end }}

{{- if and .work $mas $is_primary }}
# Work-specific applications (your-primary-host only, requires: CHEZMOI_MAS=true)
mas 'Slack (4.45.64)', id: 803453959
{{- end }}

{{- if and (not .ephemeral) $mas }}
