############################################
###               $PATH Stuff            ###
############################################
# Prepend high-priority paths (Homebrew + GNU tools take precedence over system)
typeset -U path
path+=(/opt/homebrew/bin)
path+=(/opt/homebrew/sbin)

# GNU versions of some built-in tools: https://www.topbug.net/blog/2013/04/14/install-and-use-gnu-command-line-tools-in-mac-os-x/
path+=(/opt/homebrew/opt/coreutils/libexec/gnubin)
path+=(/opt/homebrew/opt/grep/libexec/gnubin)

# Append lower-priority paths
path+=($HOME/bin)
path+=(/usr/local/bin)

# uv
path+=(/Users/baelson/.local/bin)

# Antigravity
path+=(/Users/baelson/.antigravity/antigravity/bin)

############################################
###              Homebrew Env            ###
############################################
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
export MANPATH="/opt/homebrew/share/man:/usr/local/opt/coreutils/libexec/gnuman${MANPATH+:$MANPATH}:"

############################################
###     Shell Env Non-interactive        ###
############################################
export EDITOR="antigravity --wait"
export VISUAL="antigravity --wait"
export MANPATH="/usr/local/man:$MANPATH"

# For gnutls -- https://www.topbug.net/blog/2013/04/14/install-and-use-gnu-command-line-tools-in-mac-os-x/
# export GUILE_LOAD_PATH="/opt/homebrew/share/guile/site/3.0"
# export GUILE_LOAD_COMPILED_PATH="/opt/homebrew/lib/guile/3.0/site-ccache"
# export GUILE_SYSTEM_EXTENSIONS_PATH="/opt/homebrew/lib/guile/3.0/extensions"
# export GUILE_TLS_CERTIFICATE_DIRECTORY="/opt/homebrew/etc/gnutls"

# Claude Code Agent Teams
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
