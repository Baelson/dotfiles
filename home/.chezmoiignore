# .chezmoiignore — patterns match against TARGET paths (relative to ~/)
# Syntax: doublestar.Match (NOT gitignore)
# Reference: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ── macOS system files (any depth) ──────────────────
**/.DS_Store
**/._*

# ── Repo metadata guards (root-level only) ─────────
# Defensive against future accidental ~/README.md / ~/NOTES.txt additions.
*.md
*.txt

# ── Editor temp files (any depth) ───────────────────
**/*.swp
**/*.swo
**/*~

# ── Editor project files (any depth) ────────────────
**/{.vscode,.idea}
**/{.vscode,.idea}/**
*.code-workspace
**/*.sublime-{workspace,project}

# ── Cache dirs (any depth, entry + contents) ────────
**/{.cache,Cache,Caches}
**/{.cache,Cache,Caches}/**

# ── Shell history (rapidly changing) ───────────────
{.bash_history,.zsh_history,.lesshst}

# ── GitHub CLI auth (machine-specific) ─────────────
.config/gh/hosts.yml

# ── OS-specific conditionals ───────────────────────
{{ if ne .chezmoi.os "darwin" -}}
Library/**
Brewfile
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
.config/systemd/**
.local/share/applications/**
{{- end }}

# ── Ephemeral environment (disposable containers, CI, VMs) ─
{{ if .ephemeral -}}
.ssh
.ssh/**
{{- end }}

# ── Kurama-only files (primary Mac Studio) ────────
# Excluded on all other Macs (e.g. Jennifers-iMac, Jennifers-MacBook-Pro).
# The Claude Desktop JSON is NOT ignored here — instead it's templated
# (private_claude_desktop_config.json.tmpl) so the softeria-m365 MCP
# entry drops out on non-Kurama while the rest of the config deploys.
{{ if not (and (hasKey . "is_kurama") .is_kurama) -}}
# ms365-mcp LaunchAgent + wrapper scripts
Library/LaunchAgents/com.duqueclan.ms365-mcp.plist
.local/bin/ms365-mcp-start.sh
.local/bin/ms365-mcp-stdio.sh

# Cursor IDE (config + app support)
.cursor
.cursor/**
.local/bin/open-cursor-global-workspace.sh
Library/Application Support/Cursor
Library/Application Support/Cursor/**

# Postman (app support only — cask is not gated)
Library/Application Support/Postman
Library/Application Support/Postman/**

# GitKraken
.gitkraken
.gitkraken/**
{{- end }}
