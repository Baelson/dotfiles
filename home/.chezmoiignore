# .chezmoiignore — patterns match against TARGET paths (relative to ~/)
# Syntax: doublestar.Match (NOT gitignore)
# Reference: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ── macOS system files ──────────────────────────────
.DS_Store
**/.DS_Store
._*
**/._*

# ── Repository metadata (don't deploy to ~/) ───────
.git/**
.github/**
.gitignore
.gitattributes
README*
LICENSE*
CHANGELOG*
*.md
*.txt

# ── Shell frameworks (installed by lifecycle script, not chezmoi) ──
.local/share/oh-my-zsh
.local/share/oh-my-zsh/**
.local/share/antigen
.local/share/antigen/**
.local/share/dircolors
.local/share/dircolors/**

# ── Editor temp files ───────────────────────────────
*.swp
*.swo
**/*.swp
*~
**/*~

# ── Editor project files ───────────────────────────
.vscode/
**/.vscode/
*.code-workspace
*.sublime-workspace
**/*.sublime-workspace
*.sublime-project
**/*.sublime-project
.idea/
**/.idea/

# ── Cache directories ──────────────────────────────
.cache
.cache/**
**/Cache/**
**/Caches/**
Library/Caches
Library/Caches/**

# ── Shell history (rapidly changing, not config) ───
.bash_history
.zsh_history
.lesshst

# ── GitHub CLI auth (machine-specific) ─────────────
.config/gh/hosts.yml

# ── OS-specific conditionals ───────────────────────
{{ if ne .chezmoi.os "darwin" -}}
Library/**
Brewfile
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
.config/systemd/**
.local/share/applications/**
{{- end }}

# ── Ephemeral environment exclusions ───────────────
{{ if .ephemeral -}}
.ssh
.ssh/**
.gnupg
.gnupg/**
.config/age
.config/age/**
{{- end }}
