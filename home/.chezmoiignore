# .chezmoiignore — patterns match against TARGET paths (relative to ~/)
# Syntax: doublestar.Match (NOT gitignore)
# Reference: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ── macOS system files (any depth) ──────────────────
**/.DS_Store
**/._*

# ── Repo metadata guards (root-level only) ─────────
# Defensive against future accidental ~/README.md / ~/NOTES.txt additions.
*.md
*.txt

# ── Editor temp files (any depth) ───────────────────
**/*.swp
**/*.swo
**/*~

# ── Editor project files (any depth) ────────────────
**/{.vscode,.idea}
**/{.vscode,.idea}/**
*.code-workspace
**/*.sublime-{workspace,project}

# ── Cache dirs (any depth, entry + contents) ────────
**/{.cache,Cache,Caches}
**/{.cache,Cache,Caches}/**

# ── Shell history (rapidly changing) ───────────────
{.bash_history,.zsh_history,.lesshst}

# ── GitHub CLI auth (machine-specific) ─────────────
.config/gh/hosts.yml

# ── OS-specific conditionals ───────────────────────
{{ if ne .chezmoi.os "darwin" -}}
Library/**
Brewfile
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
.config/systemd/**
.local/share/applications/**
{{- end }}

# ── Ephemeral environment (disposable containers, CI, VMs) ─
{{ if .ephemeral -}}
.ssh
.ssh/**
{{- end }}

# ── Primary-Mac-only (Mac "your-primary-host") ─────────
# Secondary Macs skip these. Claude Desktop JSON is templated
# (private_claude_desktop_config.json.tmpl), NOT ignored — softeria-m365
# MCP entry drops out on secondary Macs only.
{{ if not (and (hasKey . "is_primary") .is_primary) -}}
# Wrapper scripts (ms365-mcp LaunchAgent removed in Phase 5A; pnp-m365
# alternative runs via npx in claude_desktop_config.json.tmpl).
.local/bin/{ms365-mcp-start.sh,ms365-mcp-stdio.sh,open-cursor-global-workspace.sh}

# GUI apps (config dirs + app-support)
{.cursor,.gitkraken}
{.cursor,.gitkraken}/**
Library/Application Support/{Cursor,Postman}
Library/Application Support/{Cursor,Postman}/**
{{- end }}
