# .chezmoiignore — patterns match against TARGET paths (relative to ~/)
# Syntax: doublestar.Match (NOT gitignore)
# Reference: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ── macOS system files (any depth) ──────────────────
**/.DS_Store
**/._*

# ── Repo metadata guards (root-level only) ─────────
# Defensive against future accidental ~/README.md / ~/NOTES.txt additions.
# NB doublestar: a leading `*` does NOT cross `/`, so these match ONLY ~/*.md
# and ~/*.txt — nested managed .md/.txt (e.g. .claude/rules/*.md) are unaffected.
*.md
*.txt

# Source-tree doc co-located with the Claude Desktop config (explains how those
# templated/plain files are managed). Nested, so the root-only *.md above misses
# it — exclude by exact target path so it never lands in ~/Library/.../Claude/.
Library/Application Support/Claude/README.md

# ── Editor temp files (any depth) ───────────────────
**/*.swp
**/*.swo
**/*~

# ── Editor project files (any depth) ────────────────
**/{.vscode,.idea}
**/{.vscode,.idea}/**
*.code-workspace
**/*.sublime-{workspace,project}

# ── Cache dirs (any depth, entry + contents) ────────
**/{.cache,Cache,Caches}
**/{.cache,Cache,Caches}/**

# ── Shell history (rapidly changing) ───────────────
{.bash_history,.zsh_history,.lesshst}

# ── GitHub CLI auth (machine-specific) ─────────────
.config/gh/hosts.yml

# ── OS-specific conditionals ───────────────────────
{{ if ne .chezmoi.os "darwin" -}}
Library/**
Brewfile
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
.config/systemd/**
.local/share/applications/**
{{- end }}

# ── Ephemeral environment (disposable containers, CI, VMs) ─
{{ if .ephemeral -}}
.ssh
.ssh/**
{{- end }}

# ── Compiled binaries in ~/.local/bin — NEVER chezmoi-managed ──────────────
# A dotfiles repo tracks CONFIG, not build output. `agy` is a 137 MB Mach-O
# arm64 executable (plus a 136 MB stale `.old` backup chezmoi also adopted);
# together they exceeded GitHub's 100 MB/file limit and hard-BLOCKED every push
# to this repo (pre-receive hook declined, GH001), stranding unrelated commits.
# They are also arch-specific, so they would be wrong on a non-arm64 machine.
# Reinstall the tool per its own installer instead of syncing the binary.
# NB if anything automatically re-adds ~/.local/bin (a wrapper, an editor task, a
# git hook), a bare `chezmoi forget` is NOT enough — it gets re-adopted on the
# next run. This ignore is what makes the removal stick.
.local/bin/agy
.local/bin/agy.*.old

# Python bytecode caches — build output, never config. A `python3` that imports
# a script under ~/.local/bin (a measurement harness, a test) drops a
# __pycache__/ beside it, which the sync hook then adopts. Same rule as the
# binaries above: `forget` alone does not stick without the ignore.
.local/bin/__pycache__
.local/bin/**/__pycache__

# ── Primary-Mac-only (Mac "your-primary-host") ─────────
# Secondary Macs skip these. Claude Desktop JSON is templated
# (private_claude_desktop_config.json.tmpl), NOT ignored — softeria-m365
# MCP entry drops out on secondary Macs only.
{{ if not (and (hasKey . "is_primary") .is_primary) -}}
# open-cursor-global-workspace.sh references the local ~/Git layout (primary-only).
# (ms365-mcp wrappers fully retired 2026-06-12 — the softeria-m365 MCP was removed.)
.local/bin/open-cursor-global-workspace.sh

# GUI apps (config dirs + app-support)
{.cursor,.gitkraken}
{.cursor,.gitkraken}/**
Library/Application Support/{Cursor,Postman}
Library/Application Support/{Cursor,Postman}/**
{{- end }}
