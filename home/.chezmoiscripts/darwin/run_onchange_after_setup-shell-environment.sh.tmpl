#!/bin/zsh
#
# chezmoi Lifecycle Script: Shell Environment Setup
# =================================================
#
# This script configures shell-specific tools that aren't handled by
# chezmoi externals. Shell frameworks (oh-my-zsh, antigen, dircolors)
# are managed declaratively via .chezmoiexternal.toml.tmpl.
#
# References: https://www.chezmoi.io/user-guide/manage-different-types-of-file/
#
# Config hash: {{ include "dot_zshrc" | sha256sum }}

{{- if .headless }}
# Skip interactive shell setup in headless environments
echo "⏭️  Skipping shell environment setup in headless environment"
exit 0
{{- end }}

set -euo pipefail

echo "🐚 Setting up shell environment..."

# Install iTerm2 shell integration if not present
if [[ ! -f "${HOME}/.iterm2_shell_integration.zsh" ]]; then
    echo "🔗 Installing iTerm2 shell integration..."
    curl -fsSL https://iterm2.com/shell_integration/zsh -o "${HOME}/.iterm2_shell_integration.zsh" 2>/dev/null && \
        echo "✅ iTerm2 shell integration installed" || \
        echo "⚠️  iTerm2 shell integration download failed (non-fatal)"
fi

{{- if not .ephemeral }}
# Setup fzf key bindings and completion (persistent environments only)
if command -v fzf >/dev/null 2>&1; then
    echo "🔍 Setting up fzf key bindings..."
    if [[ ! -f "${HOME}/.fzf.zsh" ]]; then
        # Flags:
        #   --key-bindings  Install CTRL-T, CTRL-R, ALT-C key bindings for shell
        #   --completion    Install fuzzy completion for commands and paths
        #   --no-update-rc  Don't modify shell rc files (chezmoi manages those)
        "$(brew --prefix)/opt/fzf/install" \
            --key-bindings \
            --completion \
            --no-update-rc
    fi
    echo "✅ fzf configured"
fi
{{- end }}

echo "🔄 Shell environment setup completed"
