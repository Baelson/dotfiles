#!/bin/zsh
#
# chezmoi Lifecycle Script: Package Management
# ============================================
#
# This script automatically installs packages whenever the Brewfile template changes.
# Uses chezmoi's run_onchange_after_ prefix for change-triggered execution.
#
# References:
# - chezmoi run_onchange scripts: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes
# - Homebrew Bundle: https://github.com/Homebrew/homebrew-bundle
# - chezmoi templating: https://www.chezmoi.io/user-guide/templating/
#
# Script Behavior:
# - Triggered by changes to Brewfile.tmpl (detected via hash)
# - Installs CLI tools, desktop apps, and Mac App Store applications
# - Skips cleanup in ephemeral environments
# - Environment-aware package selection via template variables
#
# Brewfile hash: {{ include "Brewfile.tmpl" | sha256sum }}
#

set -euo pipefail

echo "📦 Installing packages from Brewfile..."

# Ensure Homebrew is available
if ! command -v brew >/dev/null 2>&1; then
    echo "❌ Homebrew not found. Please run the Homebrew installation script first."
    exit 1
fi

# Detect iCloud sign-in status to avoid MAS hangs
# mas install/get hangs indefinitely when no Apple ID is signed in.
# MobileMeAccounts stores iCloud account info; grep for AccountID to detect sign-in.
ICLOUD_ACCOUNT_COUNT=$(defaults read MobileMeAccounts Accounts 2>/dev/null | grep -c AccountID || true)
if [[ "${ICLOUD_ACCOUNT_COUNT}" -eq 0 ]]; then
    echo "⚠️  No Apple ID signed in — skipping Mac App Store apps"
    echo "💡 Sign into the App Store to install MAS apps, then re-run: chezmoi apply"
    # Extract all MAS app IDs from Brewfile and tell brew bundle to skip them
    # Skipper matches on either app name or numeric ID (see homebrew bundle/skipper.rb)
    MAS_IDS=$(grep '^mas ' "${HOME}/Brewfile" 2>/dev/null | sed 's/.*id: //' | tr '\n' ' ' || true)
    if [[ -n "${MAS_IDS}" ]]; then
        export HOMEBREW_BUNDLE_MAS_SKIP="${MAS_IDS}"
    fi
fi

# Install packages from Brewfile
if [[ -f "${HOME}/Brewfile" ]]; then
    echo "🍺 Running brew bundle..."
    cd "${HOME}"
    brew bundle
    echo "✅ Package installation completed"
else
    echo "⚠️  Brewfile not found at ${HOME}/Brewfile"
    echo "💡 Make sure chezmoi has applied the Brewfile configuration"
fi

{{- if not .ephemeral }}
# Clean up old packages and caches (not in ephemeral environments)
echo "🧹 Cleaning up..."
brew cleanup
brew autoremove
{{- end }}

echo "✅ Package management completed"
