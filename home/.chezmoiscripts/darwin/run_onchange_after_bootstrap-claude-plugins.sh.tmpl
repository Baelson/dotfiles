#!/bin/zsh
#
# chezmoi Lifecycle Script: Claude Code Plugin Bootstrap
# ======================================================
#
# Registers marketplaces and installs core plugins whenever the
# plugin configuration changes. Uses content-hash triggers so
# adding/removing plugins on one machine propagates to others.
#
# References:
# - Claude Code CLI: claude plugins install <plugin>[@marketplace]
# - Claude Code marketplaces: claude plugins marketplace add github:<owner>/<repo>
#
# Marketplaces hash: {{ include "dot_claude/plugins/known_marketplaces.json" | sha256sum }}
# Plugins hash: {{ include "dot_claude/plugins/installed_plugins.json" | sha256sum }}
#

set -euo pipefail

{{- if or .ephemeral .headless }}
echo "⏭️  Headless/ephemeral environment — skipping Claude plugin bootstrap"
exit 0
{{- end }}

# Skip if Claude CLI is not installed
if ! command -v claude >/dev/null 2>&1; then
    echo "⏭️  Claude Code CLI not found — skipping plugin bootstrap"
    echo "💡 Install Claude Code first: npm install -g @anthropic-ai/claude-code"
    exit 0
fi

echo "🔌 Bootstrapping Claude Code plugins..."

# ── Step 1: Register marketplaces ──────────────────────────────────────────

register_marketplace() {
    local name="$1"
    local repo="$2"
    # Check if already registered (search settings.json extraKnownMarketplaces)
    if claude plugins marketplace list 2>/dev/null | grep -q "$name"; then
        echo "  ✓ Marketplace '$name' already registered"
        return 0
    fi
    echo "  + Registering marketplace: $name ($repo)"
    claude plugins marketplace add "github:$repo" --name "$name" 2>/dev/null || {
        echo "  ⚠️  Failed to register $name — may need manual setup"
        return 0
    }
}

register_marketplace "severity1-marketplace" "severity1/severity1-marketplace"
register_marketplace "anthropic-agent-skills" "anthropics/skills"
# thedotmack is auto-discovered when installing claude-mem
# 'personal' marketplace uses directory source, registered via settings.json

# ── Step 2: Install core plugins ───────────────────────────────────────────

# Curated list of plugins to install. Personal plugins (gtd-system, pm-iwork)
# are synced as files via chezmoi and discovered by the 'personal' marketplace
# entry in settings.json — no explicit install needed for those.

PLUGINS=(
    # Official Anthropic plugins
    "superpowers@claude-plugins-official"
    "commit-commands@claude-plugins-official"
    "code-review@claude-plugins-official"
    "feature-dev@claude-plugins-official"
    "plugin-dev@claude-plugins-official"
    "hookify@claude-plugins-official"
    "claude-md-management@claude-plugins-official"
    "security-guidance@claude-plugins-official"
    "pr-review-toolkit@claude-plugins-official"
    "skill-creator@claude-plugins-official"
    "playground@claude-plugins-official"
    "explanatory-output-style@claude-plugins-official"
    "learning-output-style@claude-plugins-official"
    "claude-code-setup@claude-plugins-official"
    "agent-sdk-dev@claude-plugins-official"
    # Community plugins
    "claude-mem@thedotmack"
    "auto-memory@severity1-marketplace"
    "prompt-improver@severity1-marketplace"
    # Skills
    "document-skills@anthropic-agent-skills"
)

INSTALLED=0
SKIPPED=0
FAILED=0

for plugin in "${PLUGINS[@]}"; do
    plugin_name="${plugin%%@*}"
    if claude plugins list 2>/dev/null | grep -q "$plugin_name"; then
        SKIPPED=$((SKIPPED + 1))
        continue
    fi
    echo "  + Installing: $plugin"
    if claude plugins install "$plugin" 2>/dev/null; then
        INSTALLED=$((INSTALLED + 1))
    else
        echo "  ⚠️  Failed to install $plugin"
        FAILED=$((FAILED + 1))
    fi
done

echo "✅ Claude plugin bootstrap complete: $INSTALLED installed, $SKIPPED already present, $FAILED failed"
