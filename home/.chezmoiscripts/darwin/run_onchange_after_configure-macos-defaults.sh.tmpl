#!/bin/zsh
#
# chezmoi Lifecycle Script: macOS System Configuration
# ===================================================
#
# This script configures macOS system defaults and preferences.
# Uses chezmoi's run_onchange_after_ prefix to run when the script changes.
#
# References:
# - chezmoi run_onchange scripts: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes
# - macOS defaults: https://macos-defaults.com/
# - System preferences automation: https://github.com/mathiasbynens/dotfiles/blob/main/.macos
#
# Script Behavior:
# - Skipped in headless environments (no GUI)
# - Configures system preferences: Dock, Finder, Trackpad, Screenshots
# - Configures app preferences: Terminal.app, Moom, iTerm2
# - Disables unused macOS keyboard shortcuts
# - Environment-specific settings (work vs personal)
# - Restarts affected system applications
#
# Tier 2 apps (complex config not suited for defaults write):
# - iTerm2: Uses LoadPrefsFromCustomFolder for full profile sync
# - Moom Custom Controls: Managed via full plist (8 custom snap zones)
# - Terminal.app profiles: Binary NSArchiver data, managed via .terminal export
#

{{- if .headless }}
# Skip macOS defaults configuration in headless environments
echo "⏭️  Skipping macOS defaults configuration in headless environment"
exit 0
{{- end }}

set -euo pipefail

echo "⚙️  Configuring macOS defaults..."

# =============================================================================
# SYSTEM PREFERENCES
# =============================================================================

# Dock preferences
echo "🖥️  Configuring Dock..."
defaults write com.apple.dock "autohide" -bool "true"
defaults write com.apple.dock "show-recents" -bool "false"
defaults write com.apple.dock "tilesize" -int "48"

# Finder preferences
echo "📁 Configuring Finder..."
defaults write com.apple.finder "ShowPathbar" -bool "true"
defaults write com.apple.finder "ShowStatusBar" -bool "true"
defaults write com.apple.finder "FXDefaultSearchScope" -string "SCcf"
defaults write com.apple.finder "FXPreferredViewStyle" -string "clmv"

# Trackpad preferences
echo "🖱️  Configuring Trackpad..."
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad "Clicking" -bool "true"
defaults write com.apple.AppleMultitouchTrackpad "Clicking" -bool "true"

# Screenshots preferences
echo "📸 Configuring Screenshots..."
# shellcheck disable=SC2088  # macOS defaults expands ~ at the Cocoa level
defaults write com.apple.screencapture "location" -string "~/Desktop/Screenshots"
defaults write com.apple.screencapture "type" -string "png"
defaults write com.apple.screencapture "disable-shadow" -bool "true"
mkdir -p "${HOME}/Desktop/Screenshots"

# Keyboard shortcuts — disable unused system hotkeys
# Reference: https://web.archive.org/web/2024/https://krypted.com/mac-os-x/defaults-symbolichotkeys/
echo "⌨️  Configuring keyboard shortcuts..."
# 16/18: Accessibility zoom in/out
# 20-22: Accessibility invert/reduce/increase contrast
# 24: VoiceOver toggle
# 25/26: Input source previous/next
# 39/41: Spaces move previous/next
# 48/49: Dock toggle hiding
# 160: Accessibility controls
for hotkey_id in 16 18 20 21 22 24 25 26 39 41 48 49 160; do
    defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "${hotkey_id}" '<dict><key>enabled</key><false/></dict>'
done

{{- if .work }}
# Work-specific configurations
echo "🏢 Applying work-specific configurations..."
defaults write com.apple.screencapture "show-thumbnail" -bool "false"
{{- else }}
# Personal configurations
echo "🏠 Applying personal configurations..."
defaults write com.apple.screencapture "show-thumbnail" -bool "true"
{{- end }}

# =============================================================================
# APPLICATION PREFERENCES
# =============================================================================

# Terminal.app preferences — font-independent defaults only.
#
# The `.terminal` profile IMPORT (`open ~/.config/terminal/....terminal`)
# lives in run_onchange_after_setup-applications.sh.tmpl, which runs AFTER
# run_onchange_after_install-packages (where the MesloLGS Nerd Font cask
# gets installed). See ISSUE-024: importing here used to leave Terminal.app
# with a "Menlo" font fallback cached into the profile because the font
# cask hadn't yet installed — Powerlevel10k glyphs rendered as boxes.
# The defaults writes below are safe to run before the profile is imported:
# Terminal.app reads these at next launch and ignores a "Default Window
# Settings" string that doesn't match any imported profile (falling back
# to built-in Basic). Once setup-applications imports the profile a few
# seconds later, these defaults take effect.
echo "💻 Configuring Terminal.app defaults..."
defaults write com.apple.Terminal "Default Window Settings" -string "Solarized-Dark-NerdFont"
defaults write com.apple.Terminal "Startup Window Settings" -string "Solarized-Dark-NerdFont"
defaults write com.apple.Terminal "SecureKeyboardEntry" -bool "false"

# iTerm2 preferences — load settings from the chezmoi-managed plist.
# chezmoi deploys the templated plist to ~/.config/iterm2/com.googlecode.iterm2.plist
# (machine-specific $HOME paths are rendered from {{ "{{ .chezmoi.homeDir }}" }}); iTerm2
# LOADS from this custom folder.
echo "🖥️  Configuring iTerm2..."
# shellcheck disable=SC2088  # iTerm2 expands ~ internally for PrefsCustomFolder
defaults write com.googlecode.iterm2 "PrefsCustomFolder" -string "~/.config/iterm2"
defaults write com.googlecode.iterm2 "LoadPrefsFromCustomFolder" -bool "true"
# iTerm2 save-on-quit mode — SINGLE-MASTER so the custom-folder plist stops drifting
# across machines (it was "wrong on every Mac but the last one to sync"). The remembered
# key NoSyncNeverRemindPrefsChangesLostForFile_selection is iTermPreferenceSavePrefsMode:
#   0 = OnQuit/Copy   1 = Never/"Lose Changes" (the default)   2 = Always (auto-save)
# (verified: iTermPreferences.h enum + applicationWillTerminate/shouldSaveAutomatically in
# iTermRemotePreferences.m). The bare key (HaveSelection) silences the on-quit "Copy to
# folder?" reminder so the chosen mode applies without a dialog. (is_primary defaults to
# non-primary/read-only when the key is absent from the render context — e.g. unit-test
# env combos — via dig, mirroring Brewfile.tmpl's defensive hasKey handling.)
defaults write com.googlecode.iterm2 "NoSyncNeverRemindPrefsChangesLostForFile" -bool true
{{- if (dig "is_primary" false .) }}
# The primary Mac (.is_primary) = the single WRITER. Always(2): GUI edits auto-save to the folder
# on quit. To propagate to the other Macs: chezmoi re-add the live plist, then re-templatize
# the $HOME paths (sed '/Users/<you>' -> {{ "{{ .chezmoi.homeDir }}" }}) and commit.
defaults write com.googlecode.iterm2 "NoSyncNeverRemindPrefsChangesLostForFile_selection" -int 2
{{- else }}
# Other Macs = read-only CONSUMERS. Never(1): silenced + "Lose Changes" remembered, so iTerm2
# silently discards any local edits on quit and never writes the custom folder. chezmoi fully
# owns the live file → no last-writer-wins drift. (Edit settings here and they vanish on quit;
# author on the primary Mac.)
defaults write com.googlecode.iterm2 "NoSyncNeverRemindPrefsChangesLostForFile_selection" -int 1
{{- end }}

# Moom window manager preferences
echo "🪟 Configuring Moom..."
defaults write com.manytricks.Moom "Stealth Mode" -bool "true"
defaults write com.manytricks.Moom "Application Mode" -int 1
defaults write com.manytricks.Moom "Allow For Drawers" -bool "true"
defaults write com.manytricks.Moom "Configuration Grid: Columns" -int 8
defaults write com.manytricks.Moom "Configuration Grid: Rows" -int 8
defaults write com.manytricks.Moom "Grid Spacing" -bool "true"
defaults write com.manytricks.Moom "Grid Spacing: Apply To Edges" -bool "true"
defaults write com.manytricks.Moom "Grid Spacing: Gap" -int 4
defaults write com.manytricks.Moom "Dismiss After Filling" -bool "true"
defaults write com.manytricks.Moom "Keyboard Controls Grid" -bool "true"
defaults write com.manytricks.Moom "Mouse Controls Grid" -bool "true"
defaults write com.manytricks.Moom "Mouse Controls Grid: Columns" -int 8
defaults write com.manytricks.Moom "Mouse Controls Grid: Rows" -int 8
defaults write com.manytricks.Moom "Mouse Controls Include Custom Controls" -bool "true"
defaults write com.manytricks.Moom "Mouse Controls Include Custom Controls: Show On Hover" -bool "true"
defaults write com.manytricks.Moom "Target Window Highlight" -float 0.0

# =============================================================================
# RESTART AFFECTED SERVICES
# =============================================================================

echo "🔄 Restarting affected applications..."
killall Dock 2>/dev/null || true
killall Finder 2>/dev/null || true
killall SystemUIServer 2>/dev/null || true

# Activate keyboard shortcut changes
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true

echo "✅ macOS defaults configured successfully"
