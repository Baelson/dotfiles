#!/bin/zsh
#
# chezmoi Lifecycle Script: Application Configuration
# ==================================================
#
# This script configures installed applications and development tools.
# Uses chezmoi's run_onchange_after_ prefix to run when app configs change.
#
# References:
# - chezmoi run_onchange scripts: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes
# - Git configuration: https://git-scm.com/docs/git-config
# - VS Code settings: https://code.visualstudio.com/docs/getstarted/settings
#
# Script Behavior:
# - Skipped in headless environments
# - Configures Git, VS Code, Docker, and other development tools
# - Environment-specific application setup (personal vs work)
# - Provides guidance for manual configuration steps
#

{{- if .headless }}
# Skip application setup in headless environments
echo "⏭️  Skipping application setup in headless environment"
exit 0
{{- end }}

set -euo pipefail

echo "🚀 Configuring applications..."

# Setup Git configuration if not already configured
if ! git config --global user.email >/dev/null 2>&1; then
    echo "⚙️  Git user email not configured - please run 'git config --global user.email \"your.email@example.com\"'"
fi

if ! git config --global user.name >/dev/null 2>&1; then
    echo "⚙️  Git user name not configured - please run 'git config --global user.name \"Your Name\"'"
fi

{{- if not .ephemeral }}
# Configure VS Code settings sync if installed
if command -v code >/dev/null 2>&1; then
    echo "🔧 VS Code detected - settings will be managed by chezmoi"
fi

# Setup Docker if installed and not running
if command -v docker >/dev/null 2>&1; then
    if ! docker info >/dev/null 2>&1; then
        echo "🐳 Docker detected but not running - consider starting Docker Desktop"
    fi
fi
{{- end }}

{{- if .personal }}
# Personal environment application setup
echo "🏠 Configuring personal applications..."

# Setup Alfred workflows directory
if [[ -d "/Applications/Alfred 4.app" ]] || [[ -d "/Applications/Alfred 5.app" ]]; then
    mkdir -p "${HOME}/Library/Application Support/Alfred/workflows"
fi
{{- end }}

# =============================================================================
# Terminal.app profile import (ISSUE-024)
#
# This script runs AFTER run_onchange_after_install-packages — chezmoi sorts
# run_onchange_after_* lexicographically (install-packages < setup-applications)
# so when we reach this line, `brew bundle` has already installed
# `font-meslo-lg-nerd-font`. Previously this import lived in
# configure-macos-defaults, which runs BEFORE install-packages, so
# Terminal.app cached a "Menlo" fallback font into the imported profile and
# Powerlevel10k glyphs rendered as boxes. The defaults-write calls for
# "Default Window Settings" stay in configure-macos-defaults (font-independent).
#
# Trigger hashes: re-import if the profile file changes, OR if the Brewfile
# font line changes (in case we swap fonts). Both contribute to this
# template's rendered-content signature, which is what chezmoi watches.
#
# Terminal profile hash: {{ include "dot_config/terminal/Solarized-Dark-NerdFont.terminal" | sha256sum }}
# =============================================================================

echo "💻 Importing Terminal.app profile..."
TERMINAL_PROFILE="${HOME}/.config/terminal/Solarized-Dark-NerdFont.terminal"
if [[ -f "${TERMINAL_PROFILE}" ]]; then
    # `open` requires an Aqua/GUI session; fails in --no-graphics VMs and
    # non-interactive SSH bootstraps with OSLaunchdErrorDomain Code=125.
    # Degrade gracefully — dot_zprofile has a first-Terminal.app-launch
    # deferred-import fallback that handles the no-GUI-at-bootstrap case.
    if open "${TERMINAL_PROFILE}" 2>/dev/null; then
        sleep 1
        echo "✅ Terminal.app profile imported (font cask is now available, glyphs should render)"

        # Set "Solarized-Dark-NerdFont" as Terminal.app's default + startup
        # profile via AppleScript IPC. The `defaults write "Default Window
        # Settings"` calls in configure-macos-defaults.sh.tmpl handle the
        # cold-start case (Terminal.app not running), but the walk runs
        # install.sh INSIDE a Terminal.app window, so Terminal.app is
        # already running when configure-macos-defaults writes those
        # defaults — Terminal.app has its plist cached in memory and
        # overwrites the disk-side write on quit with its (unchanged)
        # "Basic" default. osascript reaches into the running Terminal.app
        # and updates its in-memory state directly, so the preference
        # persists on quit and new windows use our profile. See
        # ~/.claude/rules/macos-app-config.md "Plist Caching Caveat".
        # The `open` above just launched/imported into Terminal.app, so
        # it's guaranteed running at this point.
        if osascript <<'APPLE_EOF' 2>/dev/null; then
tell application "Terminal"
    set default settings to settings set "Solarized-Dark-NerdFont"
    set startup settings to settings set "Solarized-Dark-NerdFont"
end tell
APPLE_EOF
            echo "✅ Terminal.app default profile set to Solarized-Dark-NerdFont"
        else
            echo "⚠️  osascript default-profile set failed — new Terminal windows may still open with the Basic profile until you set it via Terminal → Settings → Profiles → (select Solarized-Dark-NerdFont) → 'Default'"
        fi
    else
        echo "⚠️  Could not open Terminal profile (headless / no GUI session) — dot_zprofile will import on first Terminal.app launch"
    fi
else
    echo "⚠️  Terminal profile file missing: ${TERMINAL_PROFILE}"
fi

echo "✅ Application configuration completed"
