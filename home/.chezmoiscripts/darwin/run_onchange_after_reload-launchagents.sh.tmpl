#!/bin/zsh
#
# chezmoi Lifecycle Script — Generalized LaunchAgent reloader
#
# Re-runs whenever any chezmoi-managed plist under
# ~/Library/LaunchAgents/ is added, removed, or modified. For each
# managed plist it performs a bootout+bootstrap reload so launchd picks
# up the latest definition. Safe if the agent is not currently loaded
# (bootout errors are ignored); no-op when nothing is tracked.
#
# References:
#   - https://www.chezmoi.io/reference/special-files-and-directories/#run_onchange_after_
#   - man launchctl (bootout / bootstrap)
#
# Source hash (triggers re-run when any tracked plist changes):
# {{ range $_, $path := glob (joinPath .chezmoi.sourceDir "private_Library/private_LaunchAgents/*.plist") }}{{ include $path | sha256sum }}{{ end }}{{ range $_, $path := glob (joinPath .chezmoi.sourceDir "private_Library/private_LaunchAgents/*.plist.tmpl") }}{{ include $path | sha256sum }}{{ end }}{{ range $_, $path := glob (joinPath .chezmoi.sourceDir "Library/LaunchAgents/*.plist") }}{{ include $path | sha256sum }}{{ end }}{{ range $_, $path := glob (joinPath .chezmoi.sourceDir "Library/LaunchAgents/*.plist.tmpl") }}{{ include $path | sha256sum }}{{ end }}

set -euo pipefail

UID_DOMAIN="gui/$(id -u)"
readonly UID_DOMAIN
readonly LOG_PREFIX="[chezmoi:plist-reload]"

echo "${LOG_PREFIX} Detecting managed LaunchAgent plists..."

# Get the list of chezmoi-managed plists under ~/Library/LaunchAgents/.
# `|| true` prevents `set -e` from tripping when grep finds zero matches.
managed_plists="$(chezmoi managed --include=files --path-style=absolute | grep 'LaunchAgents/.*\.plist$' || true)"

if [[ -z "${managed_plists}" ]]; then
    echo "${LOG_PREFIX} No managed plists found. Nothing to reload."
    exit 0
fi

echo "${managed_plists}" | while IFS= read -r plist; do
    [[ -f "${plist}" ]] || continue

    label="$(/usr/libexec/PlistBuddy -c "Print :Label" "${plist}" 2>/dev/null || true)"
    if [[ -z "${label}" ]]; then
        echo "${LOG_PREFIX} WARNING: No Label in $(basename "${plist}"), skipping." >&2
        continue
    fi

    echo "${LOG_PREFIX} Reloading ${label}..."

    # Unload if currently loaded (ignore errors when not loaded).
    launchctl bootout "${UID_DOMAIN}/${label}" 2>/dev/null || true

    if launchctl bootstrap "${UID_DOMAIN}" "${plist}" 2>/dev/null; then
        echo "${LOG_PREFIX} ✓ ${label} reloaded."
    else
        echo "${LOG_PREFIX} ✗ ${label} failed to load. Check: launchctl print ${UID_DOMAIN}/${label}" >&2
    fi
done

echo "${LOG_PREFIX} Done."
