{
    "gitlens.settings.mode": "advanced",
    "gitlens.menus": {
        "editor": {
            "blame": true,
            "clipboard": true,
            "compare": true,
            "details": true,
            "history": false,
            "remote": true
        },
        "editorGroup": {
            "blame": true,
            "compare": true,
            "history": false,
            "remote": false
        },
        "editorTab": {
            "compare": true,
            "history": false,
            "remote": true
        },
        "explorer": {
            "compare": true,
            "history": true,
            "remote": true
        }
    },
    "gitlens.advanced.messages": {
        "suppressFileNotUnderSourceControlWarning": true,
        "suppressGitVersionWarning": true
    },
    "editor.renderControlCharacters": true,
    "editor.minimap.enabled": true,
    "vim.disableExtension": true,
    "explorer.confirmDelete": false,
    "plantuml.diagramsRoot": "docs",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "python.pythonPath": "/opt/homebrew/bin/python3",
    "editor.detectIndentation": false,
    "files.associations": {
        "*.conf-md": "xml",
        "*.scpt": "javascript"
    },
    "[python]": {},
    "diffEditor.ignoreTrimWhitespace": false,
    "git.enableSmartCommit": true,
    "editor.tabSize": 4,
    "editor.cursorStyle": "line",
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",
    "jupyter.sendSelectionToInteractiveWindow": true,
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
    "titan.notifications.missingOsxInternalTools": false,
    "vsicons.dontShowNewVersionMessage": true,
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "git.confirmSync": false,
    "workbench.colorTheme": "Default High Contrast",
    "[applescript]": {
        "alwaysShowOutput": true,
        "files.encoding": "utf16le"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "code-runner.executorMap": {
        "javascript": "/usr/bin/env osascript -l JavaScript"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.ignoreSelection": true,
    "applescript.convertErrorRange": true,
    "applescript.alwaysShowOutput": true,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "python.showStartPage": false,
    "python.venvPath": "~/.virtualenvs",
    "python.venvFolders": [
        "virtualenvwrapper"
    ],
    "editor.accessibilitySupport": "off",
    "window.autoDetectColorScheme": true,
    "window.newWindowProfile": "Default",
    "gitlens.gitCommands.skipConfirmations": [
        "fetch:command",
        "stash-push:command",
        "switch:command"
    ],
    "githubLocalActions.dockerDesktopPath": "/Applications/Docker.app",
    "git.openRepositoryInParentFolders": "always",
    "gitlens.views.commitDetails.files.layout": "tree",
    "material-icon-theme.activeIconPack": "none",
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "cSpell.userWords": [
        "chezmoi",
        "shellenv"
    ],
    "gitlens.views.branches.branches.layout": "list",
    "explorer.confirmDragAndDrop": false,
    "shellcheck.run": "manual",
    "shellcheck.enable": false,
    "markdownlint.run": "onSave",
    "redhat.telemetry.enabled": false,
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "is:open assignee:${user} repo:${owner}/${repository}",
            "groupBy": [
                "milestone"
            ]
        },
        {
            "label": "Created Issues",
            "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
        },
        {
            "label": "Recent Issues",
            "query": "state:open repo:${owner}/${repository} sort:updated-desc"
        }
    ]
}
