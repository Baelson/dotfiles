// Place your settings in this file to overwrite the default settings
{
    "gitlens.settings.mode": "advanced",
    "gitlens.menus": {
        "editor": {
            "blame": true,
            "clipboard": true,
            "compare": true,
            "details": true,
            "history": false,
            "remote": true
        },
        "editorGroup": {
            "blame": true,
            "compare": true,
            "history": false,
            "remote": false
        },
        "editorTab": {
            "compare": true,
            "history": false,
            "remote": true
        },
        "explorer": {
            "compare": true,
            "history": true,
            "remote": true
        }
    },
    "gitlens.advanced.messages": {
        "suppressFileNotUnderSourceControlWarning": true,
        "suppressGitVersionWarning": true
    },
    "editor.renderControlCharacters": true,
    "editor.minimap.enabled": true,
    "vim.disableExtension": true,
    "explorer.confirmDelete": false,
    "plantuml.diagramsRoot": "docs",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "python.pythonPath": "/opt/homebrew/bin/python3",
    "editor.detectIndentation": false,
    "files.associations": {
        "*.conf-md": "xml",
        "*.scpt": "javascript"
    },
    "[python]": {},
    "diffEditor.ignoreTrimWhitespace": false,
    "git.enableSmartCommit": true,
    "editor.tabSize": 4,
    "editor.cursorStyle": "line",
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",
    "jupyter.sendSelectionToInteractiveWindow": true,
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
    "titan.notifications.missingOsxInternalTools": false,
    "vsicons.dontShowNewVersionMessage": true,
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "git.confirmSync": false,
    "workbench.iconTheme": "vscode-icons",
    "[applescript]": {
        "alwaysShowOutput": true,
        "files.encoding": "utf16le"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "code-runner.executorMap": {
        "javascript": "/usr/bin/env osascript -l JavaScript"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.ignoreSelection": true,
    "applescript.convertErrorRange": true,
    "applescript.alwaysShowOutput": true,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "python.showStartPage": false,
    "python.venvPath": "~/.virtualenvs",
    "python.venvFolders": [
        "virtualenvwrapper"
    ],
    "editor.accessibilitySupport": "off",
    "workbench.colorTheme": "Solarized Dark",
    "workbench.settings.applyToAllProfiles": [
        "workbench.colorTheme"
    ],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "openai.chatgpt",
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "chat.mcp.serverSampling": {
        "Global in Code: memory": {
            "allowedModels": [
                "copilot/gpt-4.1",
                "copilot/gemini-2.5-pro",
                "copilot/gpt-5-mini"
            ]
        }
    },
    "editor.renderWhitespace": "all"
}